{
  "name": "@cinaauth/cloudflare-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "migrate:local": "wrangler d1 migrations apply cinaauth-db --local",
    "migrate:remote": "wrangler d1 migrations apply cinaauth-db --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@cinaauth/api-key": "workspace:*",
    "cinaauth": "workspace:*",
    "hono": "^4.12.25",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260226.1",
    "drizzle-kit": "^0.31.10",
    "wrangler": "4.61.0",
    "typescript": "^5.9.3"
  }
}
