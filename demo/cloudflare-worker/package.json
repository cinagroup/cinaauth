{
  "name": "@cinaauth/cloudflare-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "test": "vitest run",
    "check:production": "node ./scripts/verify-production-config.mjs",
    "check:cloudflare": "node ./scripts/check-cloudflare-remote.mjs",
    "provision:secrets": "node ./scripts/provision-secrets.mjs",
    "cf-typegen": "wrangler types ./src/worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime false",
    "cf-typegen:check": "wrangler types ./src/worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime false --check",
    "check": "pnpm run check:production && pnpm run test && wrangler types ./src/worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime false --check && tsc --noEmit"
  },
  "dependencies": {
    "@cinaauth/api-key": "workspace:*",
    "@cinaauth/electron": "workspace:*",
    "@cinaauth/oauth-provider": "workspace:*",
    "@cinaauth/passkey": "workspace:*",
    "@cinaauth/scim": "workspace:*",
    "@cinaauth/sso": "workspace:*",
    "@cinaauth/stripe": "workspace:*",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^2.0.1",
    "cinaauth": "workspace:*",
    "hono": "^4.12.25",
    "stripe": "22.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260226.1",
    "wrangler": "4.61.0",
    "typescript": "^5.9.3",
    "vitest": "catalog:vitest"
  }
}
