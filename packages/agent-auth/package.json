{
  "name": "@cinaauth/agent-auth",
  "version": "1.6.26",
  "description": "Agent identity and capability authorization plugin for CinaAuth.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://www.cinagroup.com/docs/plugins/agent-auth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinagroup/cinaauth.git",
    "directory": "packages/agent-auth"
  },
  "keywords": [
    "auth",
    "agent",
    "ai",
    "capabilities",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint:package": "publint run --strict --pack false",
    "lint:types": "attw --profile esm-only --pack .",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "dev-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "dev-source": "./src/client.ts",
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    },
    "./openapi": {
      "dev-source": "./src/openapi.ts",
      "types": "./dist/openapi.d.mts",
      "default": "./dist/openapi.mjs"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.mts"
      ],
      "client": [
        "./dist/client.d.mts"
      ],
      "openapi": [
        "./dist/openapi.d.mts"
      ]
    }
  },
  "dependencies": {
    "@better-auth/agent-auth": "0.6.2",
    "@better-auth/core": "workspace:@cinaauth/core@^",
    "better-auth": "workspace:cinaauth@^"
  },
  "devDependencies": {
    "@cinaauth/core": "workspace:*",
    "cinaauth": "workspace:*",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "@cinaauth/core": "workspace:^",
    "cinaauth": "workspace:^"
  }
}
