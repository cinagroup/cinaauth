{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cinaauth-oidc-demo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-10",
  "workers_dev": false,
  "vars": {
    "CINAAUTH_OIDC_DEMO_ENVIRONMENT": "production",
    "CINAAUTH_OIDC_DEMO_ORIGIN": "https://oidc-demo.cinaseek.si",
    "CINAAUTH_URL": "https://auth.cinaseek.si",
    "CINAAUTH_ACCOUNT_ORIGIN": "https://accounts.cinaseek.si",
    "CINAAUTH_OIDC_DEMO_CLIENT_ID": "cinaauth-oidc-demo"
  },
  "routes": [
    {
      "pattern": "oidc-demo.cinaseek.si",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
