# cinaauth API host — session check + admin API calls.
CINAUTH_BASE_URL=https://auth.cinaseek.si
# cinaauth frontend host (demo-auth.cinagroup.com) — login/sign-out redirects.
CINAUTH_AUTH_URL=https://accounts.cinaseek.si
CINAUTH_ADMIN_SERVICE_KEY=replace-with-cloudflare-pages-secret
CINAADMIN_OIDC_CLIENT_SECRET=replace-with-the-same-client-secret-as-auth-worker
CINAADMIN_OIDC_BRIDGE_SECRET=replace-with-the-same-bridge-secret-as-auth-worker
CINAADMIN_OIDC_TRANSACTION_SECRET=replace-with-admin-only-transaction-secret

# Admin role whitelist (comma-separated)
CINAADMIN_ALLOWED_ROLES=super_admin,security_admin
CINAADMIN_ORIGIN=https://admin.cinaseek.si
# Canonical admin origin sent by same-origin proxy requests.
CINAUTH_REQUEST_ORIGIN=https://admin.cinaseek.si

# Public (shipped to client)
NEXT_PUBLIC_APP_NAME=CinaSeek Admin
NEXT_PUBLIC_CINAUTH_BASE_URL=https://auth.cinaseek.si
NEXT_PUBLIC_CINAUTH_AUTH_URL=https://accounts.cinaseek.si
