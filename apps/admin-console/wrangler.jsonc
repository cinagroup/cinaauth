{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cinaadmin",
	"main": "custom-worker.ts",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"routes": [
		{
			"pattern": "admin.cinaseek.ai",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "AUTH_WORKER",
			"service": "cinaauth-api"
		}
	],
	"secrets_store_secrets": [
		{
			"binding": "CINAADMIN_OIDC_CLIENT_SECRET_STORE_V2",
			"store_id": "346e2b4b86334bc29083c064116e91cf",
			"secret_name": "CINAADMIN_OIDC_CLIENT_SECRET_V2"
		},
		{
			"binding": "CINAADMIN_OIDC_BRIDGE_SECRET_STORE_V2",
			"store_id": "346e2b4b86334bc29083c064116e91cf",
			"secret_name": "CINAADMIN_OIDC_BRIDGE_SECRET_V2"
		},
		{
			"binding": "CINAADMIN_OIDC_TRANSACTION_SECRET_STORE_V2",
			"store_id": "346e2b4b86334bc29083c064116e91cf",
			"secret_name": "CINAADMIN_OIDC_TRANSACTION_SECRET_V2"
		}
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"NEXT_PUBLIC_APP_NAME": "CinaSeek Admin",
		"CINAADMIN_ORIGIN": "https://admin.cinaseek.ai",
		"CINAUTH_REQUEST_ORIGIN": "https://admin.cinaseek.ai",
		"NEXT_PUBLIC_CINAUTH_BASE_URL": "https://auth.cinaseek.ai",
		"CINAUTH_BASE_URL": "https://auth.cinaseek.ai",
		"NEXT_PUBLIC_CINAUTH_AUTH_URL": "https://accounts.cinaseek.ai",
		"CINAUTH_AUTH_URL": "https://accounts.cinaseek.ai",
		"CINAADMIN_ALLOWED_ROLES": "super_admin,security_admin"
	}
}
