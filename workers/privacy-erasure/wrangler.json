{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cinaauth-privacy-erasure",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "upload_source_maps": true,
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "version_metadata": {
    "binding": "VERSION_METADATA"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ERASURE_COORDINATOR",
        "class_name": "ErasureCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ErasureCoordinator"]
    }
  ],
  "routes": [
    {
      "pattern": "cinaauth-erasure.cinagroup.com",
      "custom_domain": true
    }
  ]
}
