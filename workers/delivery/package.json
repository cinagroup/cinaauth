{
  "name": "@cinaauth/delivery-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "test": "vitest run",
    "test:provision-secrets": "node --test ./scripts/provision-secrets.test.mjs",
    "check:cloudflare": "node ./scripts/check-cloudflare-remote.mjs",
    "acceptance:providers": "node ./scripts/run-provider-acceptance.mjs",
    "provision:secrets": "node ./scripts/provision-secrets.mjs",
    "cf-typegen": "wrangler types ./src/worker-configuration.d.ts --env-interface DeliveryWorkerEnv --include-runtime false",
    "cf-typegen:check": "wrangler types ./src/worker-configuration.d.ts --env-interface DeliveryWorkerEnv --include-runtime false --check",
    "check": "pnpm run test && pnpm run test:provision-secrets && wrangler types ./src/worker-configuration.d.ts --env-interface DeliveryWorkerEnv --include-runtime false --check && tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260226.1",
    "wrangler": "4.61.0",
    "typescript": "^5.9.3",
    "vitest": "catalog:vitest"
  }
}
