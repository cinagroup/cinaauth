# Optional legacy rollback path. Production prefers the active Secrets Store
# binding and fails closed if that present binding cannot be resolved.
CINAAUTH_DELIVERY_WEBHOOK_SECRET=replace-with-the-same-secret-used-by-cinaauth-api

# Optional legacy provider fallback. Normal production setup stages these
# values through the authenticated post-deploy configuration API instead.
RESEND_API_KEY=
RESEND_EMAIL_FROM=CinaSeek <no-reply@cinagroup.com>

# SMS delivery through Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional local overrides.
DELIVERY_ALLOWED_SKEW_SECONDS=300
DELIVERY_REPLAY_TTL_SECONDS=86400
