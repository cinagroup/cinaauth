# Cloudflare Worker local environment example
# Copy to .env only for local tooling; production secrets belong in Wrangler.

# CinaAuth signing secret (at least 32 random characters)
CINAAUTH_SECRET=your-secret-at-least-32-chars-long

# Dedicated root key for per-object R2 SSE-C encryption (at least 32 characters)
CINAAUTH_PRIVACY_EXPORT_KEY=your-export-key-at-least-32-chars-long

# Optional external processor erasure orchestrator. Configure both together.
# CINAAUTH_ERASURE_WEBHOOK_URL=https://privacy-controller.example.com/erase
# CINAAUTH_ERASURE_WEBHOOK_SECRET=your-erasure-secret-at-least-32-chars-long

# Public auth origin
CINAAUTH_URL=https://auth.cinaseek.ai

# PostgreSQL credentials are stored in the Cloudflare Hyperdrive resource.
# Do not put a production connection string in this file or wrangler.json.
