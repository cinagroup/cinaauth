{
  "name": "@cinaauth/auth-api-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:dependencies": "pnpm --filter \"@cinaauth/auth-api-worker^...\" run build",
    "deploy": "pnpm run build:dependencies && wrangler deploy",
    "build": "pnpm run build:dependencies && wrangler deploy --dry-run --outdir=dist",
    "test": "vitest run",
    "check:production": "node ./scripts/verify-production-config.mjs",
    "check:cloudflare": "node ./scripts/check-cloudflare-remote.mjs",
    "check:oidc": "node ./scripts/check-oidc-production.mjs",
    "check:planetscale-backups": "node ./scripts/check-planetscale-backups.mjs",
    "configure:hyperdrive": "node ./scripts/configure-hyperdrive.mjs",
    "configure:turnstile": "node ./scripts/configure-turnstile.mjs",
    "configure:delivery-queues": "node ./scripts/configure-delivery-queues.mjs",
    "configure:privacy-export": "node ./scripts/configure-privacy-export.mjs",
    "test:turnstile": "node --test ./scripts/configure-turnstile.test.mjs",
    "test:delivery-queues": "node --test ./scripts/configure-delivery-queues.test.mjs",
    "test:runtime-capabilities": "node --test ./scripts/check-runtime-capabilities.test.mjs",
    "test:oidc": "node --test ./scripts/check-oidc-production.test.mjs",
    "test:production-lifecycle-acceptance": "node --test ./scripts/run-production-lifecycle-acceptance.test.mjs",
    "test:backup-audit": "node --test ./scripts/check-planetscale-backups.test.mjs",
    "acceptance:production-lifecycle": "node ./scripts/run-production-lifecycle-acceptance.mjs",
    "provision:secrets": "node ./scripts/provision-secrets.mjs",
    "cf-typegen": "wrangler types ./src/worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime false",
    "cf-typegen:check": "wrangler types ./src/worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime false --check",
    "check": "pnpm run check:production && pnpm run test:backup-audit && pnpm run test:delivery-queues && pnpm run test:runtime-capabilities && pnpm run test:oidc && pnpm run test:production-lifecycle-acceptance && pnpm run test && wrangler types ./src/worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime false --check && tsc --noEmit"
  },
  "dependencies": {
    "@cinaauth/auth-web-contract": "workspace:*",
    "@cinaauth/api-key": "workspace:*",
    "@cinaauth/electron": "workspace:*",
    "@cinaauth/oauth-provider": "workspace:*",
    "@cinaauth/passkey": "workspace:*",
    "@cinaauth/scim": "workspace:*",
    "@cinaauth/sso": "workspace:*",
    "@cinaauth/stripe": "workspace:*",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^2.0.1",
    "cinaauth": "workspace:*",
    "hono": "^4.12.25",
    "pg": "^8.19.0",
    "stripe": "22.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260804.1",
    "@types/pg": "^8.16.0",
    "wrangler": "4.120.0",
    "typescript": "^5.9.3",
    "vitest": "catalog:vitest"
  }
}
