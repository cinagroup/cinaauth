{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cinaauth-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "upload_source_maps": true,
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "version_metadata": {
    "binding": "VERSION_METADATA"
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "374f6da17aff4c968cadd8d6aa454c22"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "CINAAUTH_DELIVERY_WEBHOOK_SECRET_STORE_V2",
      "store_id": "346e2b4b86334bc29083c064116e91cf",
      "secret_name": "CINAAUTH_DELIVERY_WEBHOOK_SECRET_V2"
    },
    {
      "binding": "CINAAUTH_ERASURE_WEBHOOK_SECRET_STORE_V2",
      "store_id": "346e2b4b86334bc29083c064116e91cf",
      "secret_name": "CINAAUTH_ERASURE_WEBHOOK_SECRET_V2"
    },
    {
      "binding": "CINAADMIN_OIDC_CLIENT_SECRET_STORE_V2",
      "store_id": "346e2b4b86334bc29083c064116e91cf",
      "secret_name": "CINAADMIN_OIDC_CLIENT_SECRET_V2"
    },
    {
      "binding": "CINAADMIN_OIDC_BRIDGE_SECRET_STORE_V2",
      "store_id": "346e2b4b86334bc29083c064116e91cf",
      "secret_name": "CINAADMIN_OIDC_BRIDGE_SECRET_V2"
    }
  ],
  "services": [
    {
      "binding": "CINAAUTH_DELIVERY_SERVICE",
      "service": "cinaauth-delivery"
    },
    {
      "binding": "CINAAUTH_ERASURE_SERVICE",
      "service": "cinaauth-privacy-erasure"
    }
  ],
  "d1_databases": [
    {
      "binding": "LEGACY_D1",
      "database_name": "cinaauth-db",
      "database_id": "b5063da6-673d-41e3-93c7-e63b089aaf28"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CINAAUTH_PRIVACY_EXPORTS",
      "bucket_name": "cinaauth-privacy-exports"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimitDurableObject"
      }
    ]
  },
  "exports": {
    "RateLimitDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "CINAAUTH_URL": "https://auth.cinaseek.ai",
    "CINAAUTH_ACCOUNT_ORIGIN": "https://accounts.cinaseek.ai",
    "CINAAUTH_ADMIN_ORIGIN": "https://admin.cinaseek.ai",
    "CINAAUTH_CINATOKEN_ORIGIN": "https://cinatoken.com",
    "CINAAUTH_CINATOKEN_CLIENT_ID": "cinatoken-admin",
    "CINAAUTH_PASSKEY_RP_ID": "cinaseek.ai",
    "CINAAUTH_LEGACY_ACCOUNT_ORIGIN": "https://demo-auth.cinagroup.com",
    "CINAAUTH_OIDC_DEMO_ENVIRONMENT": "production",
    "CINAAUTH_OIDC_DEMO_ORIGIN": "https://oidc-demo.cinaseek.ai",
    "CINAAUTH_OIDC_DEMO_CLIENT_ID": "cinaauth-oidc-demo",
    "CINAAUTH_CUTOVER_STATE": "live",
    "CINAAUTH_SIWE_ENABLED": "true",
    "CINAAUTH_SIWE_ALLOWED_CHAIN_IDS": "1",
    "CINAAUTH_SIWE_RP_DOMAIN": "accounts.cinaseek.ai",
    "CINAAUTH_SIWE_RP_URI": "https://accounts.cinaseek.ai",
    "CINAAUTH_SIWE_ALLOW_LEGACY": "false",
    "CINAAUTH_SIWE_AUTO_SIGNUP": "true"
  },
  "queues": {
    "producers": [
      {
        "queue": "cinaauth-delivery",
        "binding": "CINAAUTH_DELIVERY_QUEUE"
      },
      {
        "queue": "cinaauth-privacy-export",
        "binding": "CINAAUTH_PRIVACY_EXPORT_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "cinaauth-delivery",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_concurrency": 5,
        "max_retries": 5,
        "retry_delay": 30,
        "visibility_timeout_ms": 60000,
        "dead_letter_queue": "cinaauth-delivery-dlq"
      },
      {
        "queue": "cinaauth-privacy-export",
        "max_batch_size": 2,
        "max_batch_timeout": 1,
        "max_concurrency": 2,
        "max_retries": 4,
        "retry_delay": 30,
        "visibility_timeout_ms": 300000,
        "dead_letter_queue": "cinaauth-privacy-export-dlq"
      }
    ]
  },
  "routes": [
    {
      "pattern": "auth.cinaseek.ai",
      "custom_domain": true
    }
  ]
}
